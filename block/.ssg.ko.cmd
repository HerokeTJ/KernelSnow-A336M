cmd_block/ssg.ko := ld.lld -r -EL  -maarch64elf -z norelro --thinlto-cache-dir=.thinlto-cache -mllvm -import-instr-limit=5 -z noexecstack --build-id=sha1  -T scripts/module.lds -o block/ssg.ko block/ssg.lto.o block/ssg.mod.o;  make -f ./arch/arm64/Makefile.postlink block/ssg.ko ; ./scripts/generate_cfi_kallsyms.pl --module block/ssg.ko > block/ssg.lds; if [ -s block/ssg.lds ]; then ld.lld -r -EL  -maarch64elf -z norelro --thinlto-cache-dir=.thinlto-cache -mllvm -import-instr-limit=5 -z noexecstack --build-id=sha1  -T block/ssg.lds -o block/ssg.tmp.ko block/ssg.ko; mv -f block/ssg.tmp.ko block/ssg.ko; else rm -f block/ssg.lds; fi
